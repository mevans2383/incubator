SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# OpenAI — get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# Google OAuth — create at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080

# Postgres (for future use — leave blank to use SQLite)
# DATABASE_URL=postgres://user:password@localhost:5432/incubator
