# Google OAuth Client ID (from https://console.cloud.google.com/)
# Leave blank to disable Google Sign-In
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Backend API URL — leave blank for local dev (Vite proxy handles it)
# In production, set this to your Railway backend URL:
# VITE_API_URL=https://your-backend.up.railway.app
